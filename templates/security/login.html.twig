<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>Logowanie</title>
    <link rel="stylesheet" href="/css/blog.css">
</head>
<body>

<header class="header">
    <h1>Zaloguj się</h1>
</header>

<main class="container">
    {% if error %}
        <p>Nieprawidłowy email lub hasło.</p>
    {% endif %}

    <form method="post">
        <div>
            <label>Email</label>
            <input type="email" name="_username" value="{{ last_username }}" required>
        </div>

        <div>
            <label>Hasło</label>
            <input type="password" name="_password" required>
        </div>

        <button type="submit">Zaloguj się</button>
    </form>

    <p><a href="{{ path('main_page') }}">Powrót</a></p>
</main>

</body>
</html>
